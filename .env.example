# Runtime mode. live is the default for npm run dev and npm run build:live.
# npm run build currently uses Vite mode mock, so this value comes from .env.mock.
VITE_API_MODE=live

# Installation auth capability for a live build: local, sso, or mixed.
# The dev panel can change this only inside an explicit mock build.
VITE_AUTH_MODE=local

# Live API origin. Mock mode ignores this and uses the local /mock-api/ prefix.
VITE_API_BASE_URL=http://localhost:8000/api/

# Optional real provider start URL. No client secret belongs here.
# Leave empty when the provider is not configured: the UI shows an error and does not simulate SSO.
# VITE_SSO_START_URL=
# VITE_SSO_PROVIDER_LABEL=
